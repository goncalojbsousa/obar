<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.obar.desktop.admin.sections.drivers.PendingDriversController"
      spacing="0" styleClass="admin-content">

    <!-- ═══════════════════════════════════════════════════════
         COLUNA PRINCIPAL
    ═══════════════════════════════════════════════════════ -->
    <VBox spacing="14.0" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="24.0" right="26.0" bottom="24.0" left="26.0" />
        </padding>

        <!-- Cabeçalho -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Aprovações Pendentes" styleClass="title-2" />
            <Label text="Motoristas aguardam validação" styleClass="admin-subtitle" />
        </HBox>

        <!-- Banner informativo -->
        <HBox styleClass="pending-banner" spacing="10.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0" right="14.0" bottom="10.0" left="14.0" />
            </padding>
            <Label text="⚠" styleClass="pending-banner-icon" />
            <Label text="Motoristas com conta pendente não conseguem fazer login até o admin aprovar o registo."
                   styleClass="pending-banner-text" wrapText="true" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Toolbar: pesquisa + acções + contador -->
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <TextField fx:id="searchField"
                       promptText="Pesquisar por nome, email, telefone ou licença..."
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="approveButton" text="✓ Aprovar"
                    onAction="#handleApprove" styleClass="approve-button"
                    visible="false" managed="false" />
            <Button fx:id="rejectButton" text="✕ Rejeitar"
                    onAction="#handleReject" styleClass="danger"
                    visible="false" managed="false" />
            <Region HBox.hgrow="NEVER" minWidth="8" />
            <Label fx:id="listInfoLabel" text="Nenhuma aprovação pendente"
                   styleClass="admin-subtitle" />
        </HBox>

        <!-- Tabela de pendentes -->
        <TableView fx:id="pendingTable" VBox.vgrow="ALWAYS" styleClass="users-table">
            <columns>
                <TableColumn fx:id="colId"         text="ID"           prefWidth="64.0" />
                <TableColumn fx:id="colName"        text="Motorista"    prefWidth="200.0" />
                <TableColumn fx:id="colEmail"       text="Email"        prefWidth="230.0" />
                <TableColumn fx:id="colPhone"       text="Telefone"     prefWidth="120.0" />
                <TableColumn fx:id="colLicense"     text="Licença"      prefWidth="130.0" />
                <TableColumn fx:id="colRegistered"  text="Registado em" prefWidth="145.0" />
            </columns>
            <placeholder>
                <Label text="Nenhum motorista aguarda aprovação 🎉"
                       styleClass="financial-empty-state" />
            </placeholder>
        </TableView>

        <Label fx:id="feedbackLabel" text="" styleClass="feedback-success" />
    </VBox>

    <!-- ═══════════════════════════════════════════════════════
         PAINEL DE DETALHE (aparece ao seleccionar uma linha)
    ═══════════════════════════════════════════════════════ -->
    <VBox fx:id="detailPanel" spacing="12.0" styleClass="detail-panel"
          prefWidth="300.0" minWidth="280.0" visible="false" managed="false">
        <padding>
            <Insets top="24.0" right="18.0" bottom="24.0" left="18.0" />
        </padding>

        <!-- Título + fechar -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Pedido de Registo" styleClass="detail-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="X" onAction="#handleCloseDetail" styleClass="detail-close" />
        </HBox>

        <!-- Avatar gerado pelas iniciais (texto fixo — controller actualiza nome abaixo) -->
        <Label fx:id="detailNameLabel" text="—" styleClass="detail-name" wrapText="true" />
        <Label fx:id="detailEmailLabel" text="—" styleClass="admin-subtitle" />

        <!-- Badge estado -->
        <Label text="Pendente" styleClass="status-pill pending-pill" />

        <!-- Metadados -->
        <Label text="TELEFONE" styleClass="meta-title" />
        <Label fx:id="detailPhoneLabel" text="—" styleClass="meta-value" />

        <Label text="Nº DE LICENÇA" styleClass="meta-title" />
        <Label fx:id="detailLicenseLabel" text="—" styleClass="meta-value" />

        <Label text="REGISTADO EM" styleClass="meta-title" />
        <Label fx:id="detailRegisteredLabel" text="—" styleClass="meta-value" />

        <Region VBox.vgrow="ALWAYS" />

        <!-- Acções -->
        <VBox spacing="8.0" styleClass="detail-actions">
            <Button fx:id="detailApproveButton"
                    text="✓ Aprovar motorista"
                    onAction="#handleDetailApprove"
                    styleClass="approve-button"
                    maxWidth="1.7976931348623157E308"
                    visible="false" managed="false" />
            <Button fx:id="detailRejectButton"
                    text="✕ Rejeitar motorista"
                    onAction="#handleDetailReject"
                    styleClass="detail-action-danger"
                    maxWidth="1.7976931348623157E308"
                    visible="false" managed="false" />
        </VBox>
    </VBox>
</HBox>
