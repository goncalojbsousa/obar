<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.obar.desktop.auth.RegisterController"
            stylesheets="@../styles/RegisterView.css"
            styleClass="register-root">
    <center>
        <StackPane>
            <children>
                <HBox>
                    <AnchorPane HBox.hgrow="ALWAYS" styleClass="register-hero">
                <children>
                    <Region layoutX="42.0" layoutY="22.0" styleClass="register-glow-top" />
                    <Region layoutX="385.0" layoutY="468.0" styleClass="register-glow-bottom" />

                    <VBox layoutX="34.0" layoutY="34.0" spacing="18.0" styleClass="register-hero-content">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="0.0">
                                <children>
                                    <Label text="o" styleClass="logo-white" />
                                    <Label text="bar" styleClass="logo-orange" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <VBox AnchorPane.leftAnchor="34.0" AnchorPane.topAnchor="210.0" spacing="18.0"
                          styleClass="register-headline-wrap">
                        <children>
                            <TextFlow styleClass="register-headline" maxWidth="520.0">
                                <children>
                                    <Text text="Cria a tua conta,&#10;ao teu " styleClass="headline-white" />
                                    <Text text="ritmo." styleClass="headline-orange" />
                                </children>
                            </TextFlow>
                            <Label text="Junta-te ao obar em segundos e começa a viajar com rapidez e confiança."
                                   styleClass="register-hero-subtitle" wrapText="true" maxWidth="340.0" />
                        </children>
                    </VBox>

                    <HBox AnchorPane.leftAnchor="34.0" AnchorPane.bottomAnchor="32.0" spacing="42.0"
                          styleClass="register-stats-row">
                        <children>
                            <VBox spacing="2.0">
                                <children>
                                    <Label text="24/7" styleClass="stat-value" />
                                    <Label text="SUPORTE" styleClass="stat-label" />
                                </children>
                            </VBox>
                            <VBox spacing="2.0">
                                <children>
                                    <Label text="98%" styleClass="stat-value" />
                                    <Label text="SATISFAÇÃO" styleClass="stat-label" />
                                </children>
                            </VBox>
                            <VBox spacing="2.0">
                                <children>
                                    <Label text="2 MIN" styleClass="stat-value" />
                                    <Label text="ATIVAÇÃO" styleClass="stat-label" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
                    </AnchorPane>

                    <StackPane HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="register-panel">
                        <children>
                            <VBox spacing="12.0" styleClass="register-card">
                        <children>
                            <HBox spacing="0.0" styleClass="register-segment">
                                <children>
                                    <Button text="Entrar" onAction="#handleBackToLogin" styleClass="segment-idle"
                                            maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                    <Button text="Criar conta" styleClass="segment-active"
                                            maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>

                            <VBox spacing="4.0">
                                <children>
                                    <Label text="Criar conta" styleClass="register-title" />
                                    <Label text="Preenche os dados para começar" styleClass="register-subtitle" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <children>
                                    <Label text="NOME" styleClass="field-label" />
                                    <TextField fx:id="nameField" promptText="O teu nome" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <children>
                                    <Label text="EMAIL" styleClass="field-label" />
                                    <TextField fx:id="emailField" promptText="o.teu@email.com" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <children>
                                    <Label text="TIPO DE CONTA" styleClass="field-label" />
                                    <ComboBox fx:id="accountTypeComboBox" promptText="Seleciona o tipo"
                                              maxWidth="1.7976931348623157E308" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <children>
                                    <Label text="PALAVRA-PASSE" styleClass="field-label" />
                                    <PasswordField fx:id="passwordField" promptText="••••••••" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <children>
                                    <Label text="CONFIRMAR PALAVRA-PASSE" styleClass="field-label" />
                                    <PasswordField fx:id="confirmPasswordField" promptText="••••••••" />
                                </children>
                            </VBox>

                            <Button text="Criar conta" onAction="#handleRegister"
                                    maxWidth="1.7976931348623157E308" styleClass="register-submit"
                                    defaultButton="true" />

                            <HBox alignment="CENTER" spacing="8.0">
                                <children>
                                    <Separator prefWidth="112.0" />
                                    <Label text="já tens conta?" styleClass="or-label" />
                                    <Separator prefWidth="112.0" />
                                </children>
                            </HBox>

                            <Button text="Voltar" onAction="#handleBackToLogin"
                                    maxWidth="1.7976931348623157E308" styleClass="register-back"
                                    cancelButton="true" />

                            <Label fx:id="messageLabel" visible="false" managed="false" wrapText="true"
                                   styleClass="register-message" />
                        </children>
                        <padding>
                            <Insets top="22.0" right="24.0" bottom="20.0" left="24.0" />
                        </padding>
                    </VBox>
                        </children>
                    </StackPane>
                </HBox>

                <StackPane fx:id="driverPendingOverlay" visible="false" managed="false" alignment="CENTER" styleClass="pending-overlay">
                    <children>
                        <VBox spacing="8.0" styleClass="pending-card"
                              prefWidth="300.0" maxWidth="300.0"
                              prefHeight="198.0" maxHeight="198.0"
                              alignment="TOP_LEFT"
                              StackPane.alignment="CENTER">
                            <children>
                                <Label text="⏳" styleClass="pending-emoji" />
                                <Label text="Registo enviado" styleClass="pending-title" />
                                <Label fx:id="driverPendingMessageLabel"
                                       text="A tua conta de motorista foi criada e está pendente de validação por um admin."
                                       styleClass="pending-text" wrapText="true" maxWidth="256.0" />
                                <HBox alignment="CENTER" spacing="10.0">
                                    <VBox.margin>
                                        <Insets top="4.0" />
                                    </VBox.margin>
                                    <children>
                                        <Button text="Voltar ao login" onAction="#handlePendingGoToLogin"
                                                styleClass="pending-button-primary" />
                                    </children>
                                </HBox>
                            </children>
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0" />
                            </padding>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </StackPane>
    </center>
</BorderPane>
