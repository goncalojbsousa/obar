<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.obar.desktop.admin.shared.AdminModalIncludeController"
           fx:id="modalOverlay" styleClass="modal-overlay" visible="false" managed="false">
    <HBox minWidth="800.0" prefWidth="800.0" maxWidth="800.0" maxHeight="-Infinity" StackPane.alignment="CENTER">
        <Region minWidth="3.0" prefWidth="3.0" maxWidth="3.0" styleClass="admin-form-modal-stripe" />

        <VBox spacing="0.0" styleClass="admin-form-modal-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="admin-form-modal-header">
                <HBox alignment="CENTER" minWidth="38.0" minHeight="38.0" maxWidth="38.0" maxHeight="38.0"
                      styleClass="admin-form-modal-icon-box">
                    <Label fx:id="modalIconLabel" text="+" styleClass="admin-form-modal-icon-label" />
                </HBox>
                <VBox spacing="2.0">
                    <Label fx:id="modalTitleLabel" text="" styleClass="modal-title" />
                    <Label fx:id="modalSubtitleLabel" text="" styleClass="admin-form-modal-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="modalCloseButton" text="X" styleClass="admin-form-modal-close" />
            </HBox>

            <Label fx:id="modalErrorLabel" text="" styleClass="admin-form-modal-error" visible="false" managed="false" />

            <VBox fx:id="modalUsersFormSection" spacing="18.0" styleClass="admin-form-modal-body" visible="false" managed="false">
                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="NOME" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x1F464;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalNameField" promptText="Nome" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="EMAIL" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x2709;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalEmailField" promptText="Email" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="TELEFONE" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x260E;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalPhoneField" promptText="Telefone" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label fx:id="modalReferenceLabel" text="REFERENCIA" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="ID" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalReferenceField" promptText="Referencia" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <VBox spacing="5.0">
                    <Label text="ESTADO" styleClass="admin-form-field-label" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                        <Label text="&#x25CF;" styleClass="admin-form-field-icon" />
                        <ComboBox fx:id="modalStatusCombo" styleClass="admin-form-field" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="NOVA PASSWORD" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x1F512;" styleClass="admin-form-field-icon" />
                            <PasswordField fx:id="modalPasswordField" promptText="Password" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="CONFIRMAR PASSWORD" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x2713;" styleClass="admin-form-field-icon" />
                            <PasswordField fx:id="modalConfirmPasswordField" promptText="Confirmar" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="modalTripsFormSection" spacing="18.0" styleClass="admin-form-modal-body" visible="false" managed="false">
                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="CLIENTE ID" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x1F464;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTripClientIdField" promptText="ID do cliente" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="MOTORISTA ID" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x1F464;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTripDriverIdField" promptText="ID do motorista" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="TIPO" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x1F3F7;" styleClass="admin-form-field-icon" />
                            <ComboBox fx:id="modalTripTypeCombo" styleClass="admin-form-field" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="ESTADO" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x25CF;" styleClass="admin-form-field-icon" />
                            <ComboBox fx:id="modalTripStatusCombo" styleClass="admin-form-field" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="ORIGEM" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x1F4CD;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTripOriginField" promptText="Morada de origem" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="DESTINO" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x2691;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTripDestinationField" promptText="Morada de destino" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="PRECO ESTIMADO" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x20AC;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTripEstimatedPriceField" promptText="ex: 12.50" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="PRECO FINAL" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="&#x20AC;" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTripFinalPriceField" promptText="ex: 13.80" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <VBox spacing="5.0">
                    <Label text="NOTAS" styleClass="admin-form-field-label" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                        <Label text="..." styleClass="admin-form-field-icon" />
                        <TextField fx:id="modalTripNotesField" promptText="Notas opcionais" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
            </VBox>

            <VBox fx:id="modalTaxRateFormSection" spacing="18.0" styleClass="admin-form-modal-body" visible="false" managed="false">
                <VBox spacing="5.0">
                    <Label text="TAXA DE IVA" styleClass="admin-form-field-label" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                        <Label text="&#x20AC;" styleClass="admin-form-field-icon" />
                        <ComboBox fx:id="modalTaxRateCombo" styleClass="admin-form-field" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="NOME" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="ID" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTaxRateNameField" promptText="Nome da taxa" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                        <Label text="VALOR" styleClass="admin-form-field-label" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                            <Label text="IVA" styleClass="admin-form-field-icon" />
                            <TextField fx:id="modalTaxRateValueField" promptText="ex: 0.2300" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </HBox>

                <VBox spacing="5.0">
                    <Label text="DESCRICAO" styleClass="admin-form-field-label" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="admin-form-field-box" maxWidth="1.7976931348623157E308">
                        <Label text="..." styleClass="admin-form-field-icon" />
                        <TextField fx:id="modalTaxRateDescriptionField" promptText="Descricao opcional" styleClass="admin-form-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <CheckBox fx:id="modalTaxRateActiveCheck" text="Taxa ativa" selected="true" styleClass="admin-form-modal-checkbox" />
            </VBox>

            <VBox fx:id="modalDeleteSection" spacing="8.0" styleClass="admin-form-modal-body" visible="false" managed="false">
                <Label fx:id="modalDeleteMessageLabel" text="" styleClass="meta-value" wrapText="true" />
            </VBox>

            <HBox alignment="CENTER" spacing="12.0" styleClass="admin-form-modal-footer">
                <Button fx:id="modalCancelButton" text="Cancelar" styleClass="admin-form-modal-cancel"
                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <Button fx:id="modalSaveButton" text="Guardar" styleClass="admin-form-modal-save"
                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                <Button fx:id="modalDeleteConfirmButton" text="Confirmar" styleClass="admin-form-modal-delete"
                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" visible="false" managed="false" />
            </HBox>
        </VBox>
    </HBox>
</StackPane>
