<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.obar.desktop.auth.DashboardController">
    <center>
        <VBox alignment="CENTER" spacing="12.0" maxWidth="480.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>

            <Label text="Dashboard" styleClass="title-2" />
            <Label fx:id="welcomeLabel" />
            <Label fx:id="roleLabel" />
            <Label fx:id="statusLabel" />
            <Button fx:id="openAdminButton" text="Open Admin Panel" onAction="#handleOpenAdmin"
                maxWidth="280.0" styleClass="accent" />
            <Button text="Change Password" onAction="#handleChangePassword" maxWidth="280.0" />
            <Button text="Logout" onAction="#handleLogout" maxWidth="280.0" />
        </VBox>
    </center>
</BorderPane>