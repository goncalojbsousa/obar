<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.obar.desktop.admin.sections.trips.TripsController">
    <VBox fx:id="root" spacing="14.0" styleClass="admin-content">
        <padding>
            <Insets top="24.0" right="26.0" bottom="24.0" left="26.0" />
        </padding>
        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Viagens" styleClass="title-2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="addUserButton" text="+ Nova Viagem" onAction="#handleAddUser" styleClass="accent" />
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Pesquisar por ID, cliente, motorista, estado..." HBox.hgrow="ALWAYS" />
                    <Button fx:id="filterAllButton" text="Todos" onAction="#handleFilterAll" styleClass="filter-chip-active" />
                    <Button fx:id="filterActiveButton" text="Aceites" onAction="#handleFilterActive" styleClass="filter-chip" />
                    <Button fx:id="filterInactiveButton" text="Em progresso" onAction="#handleFilterInactive" styleClass="filter-chip" />
                    <Button fx:id="filterBlockedButton" text="Concluidas" onAction="#handleFilterBlocked" styleClass="filter-chip" />
                    <Button fx:id="filterPendingButton" text="Pendentes" onAction="#handleFilterPending" styleClass="filter-chip" />
                </HBox>

                <HBox spacing="8.0">
                    <Button fx:id="editUserButton" text="Editar" onAction="#handleEditUser" />
                    <Button fx:id="deleteUserButton" text="Apagar" onAction="#handleDeleteUser" styleClass="danger" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="listInfoLabel" text="A mostrar 0 viagens" styleClass="admin-subtitle" />
                </HBox>

                <TableView fx:id="tripsTable" VBox.vgrow="ALWAYS" styleClass="users-table">
                    <columns>
                        <TableColumn fx:id="tripIdColumn" text="ID" prefWidth="70.0" />
                        <TableColumn fx:id="tripClientColumn" text="Cliente" prefWidth="180.0" />
                        <TableColumn fx:id="tripDriverColumn" text="Motorista" prefWidth="180.0" />
                        <TableColumn fx:id="tripStatusColumn" text="Estado" prefWidth="120.0" />
                        <TableColumn fx:id="tripTypeColumn" text="Tipo" prefWidth="110.0" />
                        <TableColumn fx:id="tripPriceColumn" text="Valor" prefWidth="100.0" />
                        <TableColumn fx:id="tripRequestedAtColumn" text="Pedido em" prefWidth="160.0" />
                    </columns>
                </TableView>

                <Label fx:id="feedbackLabel" text="Ready." styleClass="feedback-success" />
            </VBox>

            <VBox fx:id="detailPanel" spacing="12.0" styleClass="detail-panel" prefWidth="360.0" minWidth="330.0" visible="false" managed="false">
                <HBox.margin>
                    <Insets top="-24.0" right="-26.0" bottom="-24.0" left="0.0" />
                </HBox.margin>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="detailTitleLabel" text="Detalhe da viagem" styleClass="detail-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="x" onAction="#handleCloseDetailPanel" styleClass="detail-close" />
                </HBox>
                <Label fx:id="detailInitialsLabel" text="--" styleClass="detail-avatar" />
                <Label fx:id="detailNameLabel" text="Sem selecao" styleClass="detail-name" />
                <Label fx:id="detailEmailLabel" text="-" styleClass="admin-subtitle" />
                <HBox spacing="6.0">
                    <Label fx:id="detailStatusLabel" text="-" styleClass="status-pill" />
                    <Label fx:id="detailRoleLabel" text="-" styleClass="role-pill" />
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0" styleClass="metric-card">
                        <Label fx:id="detailCardOneValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardOneTitleLabel" text="ID Cliente" styleClass="metric-title" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0" styleClass="metric-card">
                        <Label fx:id="detailCardTwoValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardTwoTitleLabel" text="ID Motorista" styleClass="metric-title" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0" styleClass="metric-card">
                        <Label fx:id="detailCardThreeValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardThreeTitleLabel" text="Veiculo" styleClass="metric-title" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0" styleClass="metric-card">
                        <Label fx:id="detailCardFourValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardFourTitleLabel" text="Distancia" styleClass="metric-title" />
                    </VBox>
                </HBox>

                <Label fx:id="detailReferenceTitleLabel" text="Preco estimado" styleClass="meta-title" />
                <Label fx:id="detailReferenceValueLabel" text="-" styleClass="meta-value" />
                <Label text="Motorista" styleClass="meta-title" />
                <Label fx:id="detailPhoneValueLabel" text="-" styleClass="meta-value" />
                <Label text="Pedido em" styleClass="meta-title" />
                <Label fx:id="detailCreatedValueLabel" text="-" styleClass="meta-value" />
                <Label fx:id="detailExtraOneTitleLabel" text="Preco final" styleClass="meta-title" />
                <Label fx:id="detailExtraOneValueLabel" text="-" styleClass="meta-value" />
                <Label fx:id="detailExtraTwoTitleLabel" text="Inicio" styleClass="meta-title" />
                <Label fx:id="detailExtraTwoValueLabel" text="-" styleClass="meta-value" />
                <Label fx:id="detailExtraThreeTitleLabel" text="Fim" styleClass="meta-title" />
                <Label fx:id="detailExtraThreeValueLabel" text="-" styleClass="meta-value" />
            </VBox>
        </HBox>
    </VBox>

    <fx:include fx:id="sharedModal" source="../../shared/admin-modal.fxml" />
</StackPane>
