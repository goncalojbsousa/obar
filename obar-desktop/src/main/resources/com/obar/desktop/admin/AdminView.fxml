<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.obar.desktop.admin.AdminController"
    prefWidth="1120.0" prefHeight="720.0">

    <BorderPane prefWidth="1120.0" prefHeight="720.0" styleClass="admin-root">

        <left>
            <VBox prefWidth="220.0" spacing="12.0" styleClass="admin-sidebar">
                <padding>
                    <Insets top="22.0" right="18.0" bottom="22.0" left="18.0" />
                </padding>

                <VBox spacing="2.0" styleClass="brand-block">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="0.0">
                            <children>
                                <Label text="o" styleClass="brand-white" />
                                <Label text="bar" styleClass="brand-orange" />
                            </children>
                        </HBox>
                        <Label text="ADMIN CONSOLE" styleClass="admin-subtitle brand-caption" />
                    </children>
                </VBox>

                <Label text="PRINCIPAL" styleClass="sidebar-group-title" />
                <Button fx:id="motoristasSectionButton" text="Motoristas"
                    onAction="#handleMotoristasSection" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-item-active" />
                <Button fx:id="clientesSectionButton" text="Clientes"
                    onAction="#handleClientesSection" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-item" />
                <Button fx:id="viagensSectionButton" text="Viagens"
                    onAction="#handleViagensSection" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-item" />
                <Button fx:id="financeiraSectionButton" text="Financeiro"
                    onAction="#handleFinanceiraSection" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-item" />

                <Label text="SISTEMA" styleClass="sidebar-group-title" />
                <Button text="Back to Dashboard" onAction="#handleBackToDashboard"
                    maxWidth="1.7976931348623157E308" styleClass="sidebar-item" />

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="10.0" maxWidth="1.7976931348623157E308" styleClass="sidebar-user-card">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="sidebarUserInitialsLabel" text="MA" styleClass="sidebar-user-avatar" />
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="sidebarUserNameLabel" text="Marcelo Admin" styleClass="sidebar-user-name" />
                                        <Label fx:id="sidebarUserRoleLabel" text="Administrador" styleClass="sidebar-user-role" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="14.0" styleClass="admin-content">
                <padding>
                    <Insets top="24.0" right="26.0" bottom="24.0" left="26.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="currentSectionLabel" text="Motoristas" styleClass="title-2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="exportPdfButton" text="Exportar PDF" onAction="#handleExportSection"
                        styleClass="flat" visible="false" managed="false" />
                    <Button fx:id="exportCsvButton" text="Exportar" onAction="#handleExportSection"
                        styleClass="flat" />
                    <Button fx:id="addUserButton" text="+ Novo Motorista" onAction="#handleAddUser"
                        styleClass="accent" />
                </HBox>

                <HBox fx:id="searchFilterRow" alignment="CENTER_LEFT" spacing="8.0">
                    <TextField fx:id="searchField"
                        promptText="Pesquisar por nome, email, telefone..." HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="periodComboBox" onAction="#handlePeriodChanged"
                        prefWidth="170.0" visible="false" managed="false" />
                    <Button fx:id="filterAllButton" text="Todos" onAction="#handleFilterAll"
                        styleClass="filter-chip-active" />
                    <Button fx:id="filterActiveButton" text="Ativos" onAction="#handleFilterActive"
                        styleClass="filter-chip" />
                    <Button fx:id="filterInactiveButton" text="Offline"
                        onAction="#handleFilterInactive" styleClass="filter-chip" />
                    <Button fx:id="filterBlockedButton" text="Bloqueados"
                        onAction="#handleFilterBlocked" styleClass="filter-chip" />
                    <Button fx:id="filterPendingButton" text="Pendentes"
                        onAction="#handleFilterPending" styleClass="filter-chip" />
                </HBox>

                <HBox fx:id="tableActionRow" alignment="CENTER_LEFT" spacing="8.0">
                    <Button fx:id="editUserButton" text="Editar" onAction="#handleEditUser" />
                    <Button fx:id="deleteUserButton" text="Bloquear/Apagar"
                        onAction="#handleDeleteUser" styleClass="danger" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="listInfoLabel" text="A mostrar 0 utilizadores"
                        styleClass="admin-subtitle" />
                </HBox>

                <VBox fx:id="financialDashboard" spacing="12.0" visible="false" managed="false">
                    <HBox spacing="8.0" styleClass="financial-period-row" alignment="CENTER_LEFT">
                        <Button fx:id="periodDayButton" text="Hoje" onAction="#handleFinancialPeriodDay"
                            styleClass="period-chip" />
                        <Button fx:id="periodWeekButton" text="7 dias" onAction="#handleFinancialPeriodWeek"
                            styleClass="period-chip" />
                        <Button fx:id="periodMonthButton" text="Este mes" onAction="#handleFinancialPeriodMonth"
                            styleClass="period-chip" />
                        <Button fx:id="periodYearButton" text="Este ano" onAction="#handleFinancialPeriodYear"
                            styleClass="period-chip" />
                        <Button fx:id="periodAllButton" text="Todo historico" onAction="#handleFinancialPeriodAll"
                            styleClass="period-chip" />
                    </HBox>

                    <HBox spacing="22.0" styleClass="financial-hero-card" alignment="CENTER_LEFT">
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="revenuePeriodLabel" text="Receita Total" styleClass="financial-hero-caption" />
                            <Label fx:id="revenueTotalLabel" text="EUR 0.00" styleClass="financial-hero-value" />
                            <Label fx:id="revenueTrendLabel" text="-" styleClass="financial-positive-trend" />
                        </VBox>

                        <HBox spacing="24.0" alignment="CENTER_LEFT">
                            <VBox spacing="4.0" styleClass="financial-side-metric">
                                <Label text="RECEITA LIQUIDA" styleClass="financial-side-label" />
                                <Label fx:id="netRevenueValueLabel" text="EUR 0.00" styleClass="financial-side-value-positive" />
                            </VBox>
                            <VBox spacing="4.0" styleClass="financial-side-metric">
                                <Label text="COMISSAO PLATAFORMA (20%)" styleClass="financial-side-label" />
                                <Label fx:id="platformCommissionValueLabel" text="EUR 0.00" styleClass="financial-side-value-warning" />
                            </VBox>
                            <VBox spacing="4.0" styleClass="financial-side-metric">
                                <Label text="VIAGENS FATURADAS" styleClass="financial-side-label" />
                                <Label fx:id="billedTripsValueLabel" text="0" styleClass="financial-side-value" />
                            </VBox>
                            <VBox spacing="4.0" styleClass="financial-side-metric">
                                <Label text="TICKET MEDIO" styleClass="financial-side-label" />
                                <Label fx:id="avgTicketValueLabel" text="EUR 0.00" styleClass="financial-side-value" />
                            </VBox>
                        </HBox>
                    </HBox>

                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0" styleClass="financial-mini-card">
                            <Label text="Pagamentos Processados" styleClass="financial-mini-title" />
                            <Label fx:id="processedPaymentsValueLabel" text="0" styleClass="financial-mini-value" />
                            <Label text="total no periodo" styleClass="financial-mini-note" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0" styleClass="financial-mini-card">
                            <Label text="Reembolsos" styleClass="financial-mini-title" />
                            <Label fx:id="refundedPaymentsValueLabel" text="0" styleClass="financial-mini-value" />
                            <Label text="pagamentos reembolsados" styleClass="financial-mini-note" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0" styleClass="financial-mini-card">
                            <Label text="Tx. Pagamentos Falhados" styleClass="financial-mini-title" />
                            <Label fx:id="failedRateValueLabel" text="0%" styleClass="financial-mini-value" />
                            <Label text="sobre total de pagamentos" styleClass="financial-mini-note" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0" styleClass="financial-mini-card">
                            <Label text="Motoristas Pagos" styleClass="financial-mini-title" />
                            <Label fx:id="paidDriversValueLabel" text="0" styleClass="financial-mini-value" />
                            <Label text="com pagamentos processados" styleClass="financial-mini-note" />
                        </VBox>
                    </HBox>

                    <HBox spacing="10.0">
                        <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="financial-chart-card">
                            <Label text="Receita diaria" styleClass="financial-chart-title" />
                            <HBox fx:id="dailyBarsContainer" spacing="8.0" alignment="BOTTOM_LEFT" />
                        </VBox>

                        <VBox prefWidth="290.0" spacing="10.0" styleClass="financial-methods-card">
                            <Label text="Metodos de Pagamento" styleClass="financial-chart-title" />

                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="" styleClass="method-dot method-dot-one" />
                                <Label fx:id="methodOneLabel" text="-" styleClass="financial-method-name" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="methodOnePercentLabel" text="0%" styleClass="financial-method-percent" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="" styleClass="method-dot method-dot-two" />
                                <Label fx:id="methodTwoLabel" text="-" styleClass="financial-method-name" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="methodTwoPercentLabel" text="0%" styleClass="financial-method-percent" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="" styleClass="method-dot method-dot-three" />
                                <Label fx:id="methodThreeLabel" text="-" styleClass="financial-method-name" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="methodThreePercentLabel" text="0%" styleClass="financial-method-percent" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="" styleClass="method-dot method-dot-four" />
                                <Label fx:id="methodFourLabel" text="-" styleClass="financial-method-name" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="methodFourPercentLabel" text="0%" styleClass="financial-method-percent" />
                            </HBox>
                        </VBox>
                    </HBox>

                    <Label fx:id="paymentsTableTitle" text="Ultimos Pagamentos" styleClass="financial-table-title" />
                </VBox>

                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="users-table">
                    <columns>
                        <TableColumn fx:id="userIdColumn" text="ID" prefWidth="70.0" />
                        <TableColumn fx:id="nameColumn" text="Motorista" prefWidth="200.0" />
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="220.0" />
                        <TableColumn fx:id="statusColumn" text="Estado" prefWidth="105.0" />
                        <TableColumn fx:id="metricColumn" text="Avaliacao" prefWidth="105.0" />
                        <TableColumn fx:id="volumeColumn" text="Viagens" prefWidth="95.0" />
                        <TableColumn fx:id="referenceColumn" text="Licenca" prefWidth="120.0" />
                        <TableColumn fx:id="createdAtColumn" text="Registado em" prefWidth="140.0" />
                    </columns>
                </TableView>

                <TableView fx:id="tripsTable" VBox.vgrow="ALWAYS" styleClass="users-table"
                    visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="tripIdColumn" text="ID" prefWidth="70.0" />
                        <TableColumn fx:id="tripClientColumn" text="Cliente" prefWidth="180.0" />
                        <TableColumn fx:id="tripDriverColumn" text="Motorista" prefWidth="180.0" />
                        <TableColumn fx:id="tripStatusColumn" text="Estado" prefWidth="120.0" />
                        <TableColumn fx:id="tripTypeColumn" text="Tipo" prefWidth="110.0" />
                        <TableColumn fx:id="tripPriceColumn" text="Valor" prefWidth="100.0" />
                        <TableColumn fx:id="tripRequestedAtColumn" text="Pedido em" prefWidth="160.0" />
                    </columns>
                </TableView>

                <TableView fx:id="paymentsTable" VBox.vgrow="ALWAYS" styleClass="users-table"
                    visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="paymentIdColumn" text="Pagamento" prefWidth="92.0" />
                        <TableColumn fx:id="paymentTripIdColumn" text="Viagem" prefWidth="78.0" />
                        <TableColumn fx:id="paymentClientColumn" text="Cliente" prefWidth="170.0" />
                        <TableColumn fx:id="paymentMethodColumn" text="Metodo" prefWidth="170.0" />
                        <TableColumn fx:id="paymentAmountColumn" text="Valor" prefWidth="130.0" />
                        <TableColumn fx:id="paymentStatusColumn" text="Estado" prefWidth="120.0" />
                        <TableColumn fx:id="paymentDateColumn" text="Data" prefWidth="170.0" />
                    </columns>
                </TableView>

                <Label fx:id="feedbackLabel" text="Ready." styleClass="feedback-success" />
            </VBox>
        </center>

        <right>
            <VBox fx:id="detailPanel" prefWidth="340.0" spacing="12.0" styleClass="detail-panel"
                visible="false" managed="false">
                <padding>
                    <Insets top="24.0" right="18.0" bottom="24.0" left="18.0" />
                </padding>

                <Label fx:id="detailTitleLabel" text="Detalhe do utilizador" styleClass="detail-title"
                    wrapText="true" maxWidth="300.0" />
                <Label fx:id="detailInitialsLabel" text="--" styleClass="detail-avatar" />
                <Label fx:id="detailNameLabel" text="Sem selecao" styleClass="detail-name"
                    wrapText="true" maxWidth="300.0" />
                <Label fx:id="detailEmailLabel" text="-" styleClass="admin-subtitle" wrapText="true"
                    maxWidth="300.0" />

                <HBox spacing="6.0">
                    <Label fx:id="detailStatusLabel" text="-" styleClass="status-pill" />
                    <Label fx:id="detailRoleLabel" text="-" styleClass="role-pill" />
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="2.0">
                        <Label fx:id="detailCardOneValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardOneTitleLabel" text="Avaliacao"
                            styleClass="metric-title" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="2.0">
                        <Label fx:id="detailCardTwoValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardTwoTitleLabel" text="Viagens"
                            styleClass="metric-title" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="2.0">
                        <Label fx:id="detailCardThreeValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardThreeTitleLabel" text="Disponibilidade"
                            styleClass="metric-title" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="metric-card" spacing="2.0">
                        <Label fx:id="detailCardFourValueLabel" text="-" styleClass="metric-value" />
                        <Label fx:id="detailCardFourTitleLabel" text="Estado"
                            styleClass="metric-title" />
                    </VBox>
                </HBox>

                <Label fx:id="detailReferenceTitleLabel" text="N de Licenca" styleClass="meta-title"
                    wrapText="true" maxWidth="300.0" />
                <Label fx:id="detailReferenceValueLabel" text="-" styleClass="meta-value"
                    wrapText="true" maxWidth="300.0" />
                <Label text="Telefone" styleClass="meta-title" wrapText="true" maxWidth="300.0" />
                <Label fx:id="detailPhoneValueLabel" text="-" styleClass="meta-value" wrapText="true"
                    maxWidth="300.0" />
                <Label text="Registado em" styleClass="meta-title" wrapText="true" maxWidth="300.0" />
                <Label fx:id="detailCreatedValueLabel" text="-" styleClass="meta-value" wrapText="true"
                    maxWidth="300.0" />

                <Label fx:id="detailExtraOneTitleLabel" text="" styleClass="meta-title" wrapText="true"
                    maxWidth="300.0" />
                <Label fx:id="detailExtraOneValueLabel" text="-" styleClass="meta-value" wrapText="true"
                    maxWidth="300.0" />
                <Label fx:id="detailExtraTwoTitleLabel" text="" styleClass="meta-title" wrapText="true"
                    maxWidth="300.0" />
                <Label fx:id="detailExtraTwoValueLabel" text="-" styleClass="meta-value" wrapText="true"
                    maxWidth="300.0" />
                <Label fx:id="detailExtraThreeTitleLabel" text="" styleClass="meta-title" wrapText="true"
                    maxWidth="300.0" />
                <Label fx:id="detailExtraThreeValueLabel" text="-" styleClass="meta-value" wrapText="true"
                    maxWidth="300.0" />
                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </right>
    </BorderPane>

    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false" managed="false"
        alignment="CENTER">
        <VBox styleClass="modal-card" spacing="12.0" maxWidth="760.0" minWidth="680.0"
            prefWidth="720.0" maxHeight="-Infinity" StackPane.alignment="CENTER">
            <padding>
                <Insets top="22.0" right="22.0" bottom="22.0" left="22.0" />
            </padding>

            <Label fx:id="modalTitleLabel" text="" styleClass="modal-title" />
            <Label fx:id="modalErrorLabel" text="" styleClass="feedback-error" visible="false"
                managed="false" />

            <VBox fx:id="modalUserFormSection" spacing="10.0">
                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Nome" styleClass="meta-title" />
                        <TextField fx:id="modalNameField" promptText="Nome" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Email" styleClass="meta-title" />
                        <TextField fx:id="modalEmailField" promptText="Email" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Telefone" styleClass="meta-title" />
                        <TextField fx:id="modalPhoneField" promptText="Telefone" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label fx:id="modalReferenceLabel" text="Licenca" styleClass="meta-title" />
                        <TextField fx:id="modalReferenceField" promptText="Referencia" />
                    </VBox>
                </HBox>

                <VBox spacing="4.0">
                    <Label text="Estado" styleClass="meta-title" />
                    <ComboBox fx:id="modalStatusCombo" maxWidth="1.7976931348623157E308" />
                </VBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Password" styleClass="meta-title" />
                        <PasswordField fx:id="modalPasswordField" promptText="Password" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Confirmar password" styleClass="meta-title" />
                        <PasswordField fx:id="modalConfirmPasswordField" promptText="Confirmar" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="modalTripFormSection" spacing="10.0" visible="false" managed="false">
                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Cliente ID" styleClass="meta-title" />
                        <TextField fx:id="modalTripClientIdField" promptText="ID do cliente" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Motorista ID (opcional)" styleClass="meta-title" />
                        <TextField fx:id="modalTripDriverIdField" promptText="ID do motorista" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Tipo" styleClass="meta-title" />
                        <ComboBox fx:id="modalTripTypeCombo" maxWidth="1.7976931348623157E308" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Estado" styleClass="meta-title" />
                        <ComboBox fx:id="modalTripStatusCombo" maxWidth="1.7976931348623157E308" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Origem" styleClass="meta-title" />
                        <TextField fx:id="modalTripOriginField" promptText="Morada de origem" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Destino" styleClass="meta-title" />
                        <TextField fx:id="modalTripDestinationField" promptText="Morada de destino" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Preco estimado" styleClass="meta-title" />
                        <TextField fx:id="modalTripEstimatedPriceField" promptText="ex: 12.50" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Preco final" styleClass="meta-title" />
                        <TextField fx:id="modalTripFinalPriceField" promptText="ex: 13.80" />
                    </VBox>
                </HBox>

                <VBox spacing="4.0">
                    <Label text="Notas" styleClass="meta-title" />
                    <TextField fx:id="modalTripNotesField" promptText="Notas opcionais" />
                </VBox>
            </VBox>

            <VBox fx:id="modalTaxRateFormSection" spacing="10.0" visible="false" managed="false">
                <VBox spacing="4.0">
                    <Label text="Taxa de IVA" styleClass="meta-title" />
                    <ComboBox fx:id="modalTaxRateCombo" maxWidth="1.7976931348623157E308" />
                </VBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Nome" styleClass="meta-title" />
                        <TextField fx:id="modalTaxRateNameField" promptText="Nome da taxa" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Valor (0-1)" styleClass="meta-title" />
                        <TextField fx:id="modalTaxRateValueField" promptText="ex: 0.2300" />
                    </VBox>
                </HBox>

                <VBox spacing="4.0">
                    <Label text="Descricao" styleClass="meta-title" />
                    <TextField fx:id="modalTaxRateDescriptionField" promptText="Descricao opcional" />
                </VBox>

                <CheckBox fx:id="modalTaxRateActiveCheck" text="Taxa ativa" selected="true" />
            </VBox>

            <VBox fx:id="modalDeleteSection" spacing="8.0" visible="false" managed="false">
                <Label fx:id="modalDeleteMessageLabel" text="" styleClass="meta-value"
                    wrapText="true" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <Button text="Cancelar" onAction="#handleModalCancel" styleClass="flat" />
                <Button fx:id="modalSaveButton" text="Guardar" onAction="#handleModalSave"
                    styleClass="accent" />
                <Button fx:id="modalDeleteConfirmButton" text="Confirmar"
                    onAction="#handleModalConfirmDelete" styleClass="danger" visible="false"
                    managed="false" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>