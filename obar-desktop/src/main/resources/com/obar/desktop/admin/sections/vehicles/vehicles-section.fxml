<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.obar.desktop.admin.sections.vehicles.VehiclesController">
    <VBox spacing="14.0" styleClass="admin-content">
        <padding>
            <Insets top="24.0" right="26.0" bottom="24.0" left="26.0" />
        </padding>
        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Veiculos" styleClass="title-2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="+ Novo Veiculo" onAction="#handleAddVehicle" styleClass="accent" />
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Pesquisar por marca, matricula, motorista, categoria..." HBox.hgrow="ALWAYS" />
                    <Button fx:id="filterAllButton" text="Todos" onAction="#handleFilterAll" styleClass="filter-chip-active" />
                    <Button fx:id="filterActiveButton" text="Ativos" onAction="#handleFilterActive" styleClass="filter-chip" />
                    <Button fx:id="filterInactiveButton" text="Inativos" onAction="#handleFilterInactive" styleClass="filter-chip" />
                </HBox>

                <HBox spacing="8.0">
                    <Button text="Editar" onAction="#handleEditVehicle" />
                    <Button fx:id="deactivateVehicleButton" text="Desativar" onAction="#handleDeactivateVehicle" styleClass="danger" />
                    <Button fx:id="reactivateVehicleButton" text="Ativar" onAction="#handleReactivateVehicle" />
                    <Button text="Apagar" onAction="#handleDeleteVehicle" styleClass="danger" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="listInfoLabel" text="A mostrar 0 veiculos" styleClass="admin-subtitle" />
                </HBox>

                <TableView fx:id="vehiclesTable" VBox.vgrow="ALWAYS" styleClass="users-table">
                    <columns>
                        <TableColumn fx:id="vehicleIdColumn" text="ID" prefWidth="70.0" />
                        <TableColumn fx:id="vehicleColumn" text="Veiculo" prefWidth="190.0" />
                        <TableColumn fx:id="licensePlateColumn" text="Matricula" prefWidth="115.0" />
                        <TableColumn fx:id="driverColumn" text="Motorista" prefWidth="200.0" />
                        <TableColumn fx:id="categoryColumn" text="Categoria" prefWidth="110.0" />
                        <TableColumn fx:id="yearColumn" text="Ano" prefWidth="75.0" />
                        <TableColumn fx:id="activeColumn" text="Estado" prefWidth="95.0" />
                    </columns>
                </TableView>

                <Label fx:id="feedbackLabel" text="Ready." styleClass="feedback-success" />
            </VBox>

            <VBox fx:id="detailPanel" spacing="10.0" styleClass="detail-panel" prefWidth="360.0" minWidth="330.0" visible="false" managed="false">
                <HBox.margin>
                    <Insets top="-24.0" right="-26.0" bottom="-24.0" left="0.0" />
                </HBox.margin>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="detailTitleLabel" text="Detalhe do veiculo" styleClass="detail-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="X" onAction="#handleCloseDetailPanel" styleClass="detail-close" />
                </HBox>
                <Label fx:id="detailVehicleLabel" text="Sem selecao" styleClass="detail-name" />
                <Label fx:id="detailLicensePlateLabel" text="-" styleClass="admin-subtitle" />
                <HBox spacing="6.0">
                    <Label fx:id="detailStatusLabel" text="-" styleClass="status-pill" />
                </HBox>
                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0" styleClass="metric-card">
                        <Label fx:id="detailBaseFareLabel" text="-" styleClass="metric-value" />
                        <Label text="Tarifa base" styleClass="metric-title" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="2.0" styleClass="metric-card">
                        <Label fx:id="detailPricePerKmLabel" text="-" styleClass="metric-value" />
                        <Label text="Preco por km" styleClass="metric-title" />
                    </VBox>
                </HBox>
                <Label text="Motorista" styleClass="meta-title" />
                <Label fx:id="detailDriverLabel" text="-" styleClass="meta-value" />
                <Label text="Categoria" styleClass="meta-title" />
                <Label fx:id="detailCategoryLabel" text="-" styleClass="meta-value" />
                <Label text="Ano" styleClass="meta-title" />
                <Label fx:id="detailYearLabel" text="-" styleClass="meta-value" />
                <Label text="Cor" styleClass="meta-title" />
                <Label fx:id="detailColorLabel" text="-" styleClass="meta-value" />
                <VBox spacing="8.0" styleClass="detail-actions">
                    <Button text="Editar veiculo" onAction="#handleEditVehicle" styleClass="detail-action" maxWidth="1.7976931348623157E308" />
                    <Button fx:id="detailDeactivateVehicleButton" text="Desativar veiculo" onAction="#handleDeactivateVehicle" styleClass="detail-action-danger" maxWidth="1.7976931348623157E308" />
                    <Button fx:id="detailReactivateVehicleButton" text="Ativar veiculo" onAction="#handleReactivateVehicle" styleClass="detail-action" maxWidth="1.7976931348623157E308" />
                    <Button text="Apagar veiculo" onAction="#handleDeleteVehicle" styleClass="detail-action-danger" maxWidth="1.7976931348623157E308" />
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </VBox>

    <StackPane fx:id="vehicleModalOverlay" styleClass="modal-overlay" visible="false" managed="false">
        <VBox spacing="12.0" styleClass="modal-card vehicle-modal-card" maxHeight="-Infinity">
            <Label fx:id="vehicleModalTitleLabel" text="" styleClass="modal-title" />
            <Label fx:id="vehicleModalErrorLabel" text="" styleClass="feedback-error" visible="false" managed="false" />

            <VBox fx:id="vehicleFormSection" spacing="10.0">
                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Motorista ID" styleClass="meta-title" />
                        <TextField fx:id="driverIdField" promptText="ID do motorista" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Matricula" styleClass="meta-title" />
                        <TextField fx:id="licensePlateField" promptText="ex: AA-00-00" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Marca" styleClass="meta-title" />
                        <TextField fx:id="brandField" promptText="Marca" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Modelo" styleClass="meta-title" />
                        <TextField fx:id="modelField" promptText="Modelo" />
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <VBox spacing="4.0" prefWidth="180.0" maxWidth="180.0">
                        <Label text="Categoria" styleClass="meta-title" />
                        <ComboBox fx:id="categoryComboBox" promptText="Categoria" prefWidth="180.0" maxWidth="180.0" styleClass="vehicle-category-combo" />
                    </VBox>
                    <VBox spacing="4.0" prefWidth="130.0" maxWidth="130.0">
                        <Label text="Ano" styleClass="meta-title" />
                        <TextField fx:id="yearField" promptText="ex: 2022" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox spacing="8.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Cor" styleClass="meta-title" />
                        <TextField fx:id="colorField" promptText="Cor" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Tarifa base" styleClass="meta-title" />
                        <TextField fx:id="baseFareField" promptText="ex: 3.50" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Preco por km" styleClass="meta-title" />
                        <TextField fx:id="pricePerKmField" promptText="ex: 0.90" />
                    </VBox>
                </HBox>

                <CheckBox fx:id="activeCheckBox" text="Veiculo ativo" selected="true" />
            </VBox>

            <VBox fx:id="vehicleConfirmSection" spacing="8.0" visible="false" managed="false">
                <Label fx:id="vehicleConfirmMessageLabel" text="" styleClass="meta-value" wrapText="true" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <Button text="Cancelar" onAction="#handleModalCancel" styleClass="flat" />
                <Button fx:id="modalSaveButton" text="Guardar" onAction="#handleModalSave" styleClass="accent" />
                <Button fx:id="modalDeactivateButton" text="Confirmar" onAction="#handleModalDeactivate" styleClass="danger" visible="false" managed="false" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
