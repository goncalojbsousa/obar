<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.obar.desktop.auth.RegisterController"
            stylesheets="@../styles/RegisterView.css"
            styleClass="register-root">
    <center>
        <StackPane>
            <children>
                <HBox>
                    <!-- ══ HERO ══════════════════════════════════════════ -->
                    <AnchorPane HBox.hgrow="ALWAYS" styleClass="register-hero">
                        <children>
                            <Region layoutX="42.0"  layoutY="22.0"  styleClass="register-glow-top" />
                            <Region layoutX="385.0" layoutY="468.0" styleClass="register-glow-bottom" />

                            <VBox layoutX="34.0" layoutY="34.0" spacing="18.0" styleClass="register-hero-content">
                                <HBox alignment="CENTER_LEFT" spacing="0.0">
                                    <Label text="o" styleClass="logo-white" />
                                    <Label text="bar" styleClass="logo-orange" />
                                </HBox>
                            </VBox>

                            <VBox AnchorPane.leftAnchor="34.0" AnchorPane.topAnchor="210.0" spacing="18.0"
                                  styleClass="register-headline-wrap">
                                <TextFlow styleClass="register-headline" maxWidth="520.0">
                                    <Text text="Cria a tua conta,&#10;ao teu " styleClass="headline-white" />
                                    <Text text="ritmo." styleClass="headline-orange" />
                                </TextFlow>
                                <Label text="Junta-te ao obar em segundos e começa a viajar com rapidez e confiança."
                                       styleClass="register-hero-subtitle" wrapText="true" maxWidth="340.0" />
                            </VBox>

                            <HBox AnchorPane.leftAnchor="34.0" AnchorPane.bottomAnchor="32.0" spacing="42.0"
                                  styleClass="register-stats-row">
                                <VBox spacing="2.0">
                                    <Label text="24/7"   styleClass="stat-value" />
                                    <Label text="SUPORTE" styleClass="stat-label" />
                                </VBox>
                                <VBox spacing="2.0">
                                    <Label text="98%"       styleClass="stat-value" />
                                    <Label text="SATISFAÇÃO" styleClass="stat-label" />
                                </VBox>
                                <VBox spacing="2.0">
                                    <Label text="2 MIN"    styleClass="stat-value" />
                                    <Label text="ATIVAÇÃO" styleClass="stat-label" />
                                </VBox>
                            </HBox>
                        </children>
                    </AnchorPane>

                    <!-- ══ PAINEL DE REGISTO ═════════════════════════════ -->
                    <StackPane HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="register-panel">
                        <VBox spacing="10.0" styleClass="register-card">
                            <padding>
                                <Insets top="20.0" right="24.0" bottom="18.0" left="24.0" />
                            </padding>

                            <!-- Segment -->
                            <HBox spacing="0.0" styleClass="register-segment">
                                <Button text="Entrar" onAction="#handleBackToLogin" styleClass="segment-idle"
                                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                <Button text="Criar conta" styleClass="segment-active"
                                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                            </HBox>

                            <!-- Título -->
                            <VBox spacing="2.0">
                                <Label text="Criar conta" styleClass="register-title" />
                                <Label text="Preenche os dados para começar" styleClass="register-subtitle" />
                            </VBox>

                            <!-- Grid 2 colunas -->
                            <GridPane hgap="12.0" vgap="12.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                </columnConstraints>

                                <!-- Nome -->
                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="NOME" styleClass="field-label" />
                                    <TextField fx:id="nameField" promptText="O teu nome" maxWidth="1.7976931348623157E308" />
                                </VBox>

                                <!-- Telefone -->
                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="TELEFONE" styleClass="field-label" />
                                    <TextField fx:id="phoneField" promptText="+351 9xx xxx xxx" maxWidth="1.7976931348623157E308" />
                                </VBox>

                                <!-- Email -->
                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                    <Label text="EMAIL" styleClass="field-label" />
                                    <TextField fx:id="emailField" promptText="o.teu@email.com" maxWidth="1.7976931348623157E308" />
                                </VBox>

                                <!-- Tipo de conta -->
                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="TIPO DE CONTA" styleClass="field-label" />
                                    <ComboBox fx:id="accountTypeComboBox" promptText="Seleciona o tipo"
                                              maxWidth="1.7976931348623157E308" onAction="#handleAccountTypeChanged" />
                                </VBox>

                                <!-- NIF / Licença (label dinâmico) -->
                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label fx:id="referenceLabel" text="NIF" styleClass="field-label" />
                                    <TextField fx:id="referenceField" promptText="000000000" maxWidth="1.7976931348623157E308" />
                                </VBox>

                                <!-- Palavra-passe -->
                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label text="PALAVRA-PASSE" styleClass="field-label" />
                                    <PasswordField fx:id="passwordField" promptText="••••••••" maxWidth="1.7976931348623157E308" />
                                </VBox>

                                <!-- Confirmar palavra-passe -->
                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="CONFIRMAR PALAVRA-PASSE" styleClass="field-label" />
                                    <PasswordField fx:id="confirmPasswordField" promptText="••••••••" maxWidth="1.7976931348623157E308" />
                                </VBox>
                            </GridPane>

                            <!-- Botão criar -->
                            <Button text="Criar conta" onAction="#handleRegister"
                                    maxWidth="1.7976931348623157E308" styleClass="register-submit"
                                    defaultButton="true" />

                            <!-- Separador -->
                            <HBox alignment="CENTER" spacing="8.0">
                                <Separator prefWidth="112.0" />
                                <Label text="já tens conta?" styleClass="or-label" />
                                <Separator prefWidth="112.0" />
                            </HBox>

                            <Button text="Voltar" onAction="#handleBackToLogin"
                                    maxWidth="1.7976931348623157E808" styleClass="register-back"
                                    cancelButton="true" />

                            <Label fx:id="messageLabel" visible="false" managed="false"
                                   wrapText="true" styleClass="register-message" />
                        </VBox>
                    </StackPane>
                </HBox>

                <!-- ══ OVERLAY PENDENTE (motorista) ══════════════════════ -->
                <StackPane fx:id="driverPendingOverlay" visible="false" managed="false"
                           alignment="CENTER" styleClass="pending-overlay">
                    <VBox spacing="8.0" styleClass="pending-card"
                          prefWidth="300.0" maxWidth="300.0"
                          alignment="TOP_LEFT" StackPane.alignment="CENTER">
                        <padding>
                            <Insets top="14.0" right="14.0" bottom="14.0" left="14.0" />
                        </padding>
                        <Label text="⏳" styleClass="pending-emoji" />
                        <Label text="Registo enviado" styleClass="pending-title" />
                        <Label fx:id="driverPendingMessageLabel"
                               text="A tua conta de motorista foi criada e está pendente de validação por um admin."
                               styleClass="pending-text" wrapText="true" maxWidth="256.0" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <VBox.margin><Insets top="4.0" /></VBox.margin>
                            <Button text="Voltar ao login" onAction="#handlePendingGoToLogin"
                                    styleClass="pending-button-primary" />
                        </HBox>
                    </VBox>
                </StackPane>
            </children>
        </StackPane>
    </center>
</BorderPane>
