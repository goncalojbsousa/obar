<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.obar.desktop.auth.LoginController">
    <center>
        <VBox alignment="CENTER" spacing="14.0" maxWidth="380.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>

            <Label text="OBAR Desktop" />
            <TextField fx:id="emailField" promptText="Email" maxWidth="320.0" />
            <PasswordField fx:id="passwordField" promptText="Password" maxWidth="320.0" />
            <Button text="Login" onAction="#handleLogin" maxWidth="320.0" defaultButton="true" />
            <Button text="Create Account" onAction="#handleGoToRegister" maxWidth="320.0" />
            <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true" maxWidth="320.0" />
        </VBox>
    </center>
</BorderPane>
